{
  "name": "byo-llm-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + TypeScript starter kit for BYO-LLM SaaS projects",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm build && node examples/web/server.mjs",
    "build": "tsc -p tsconfig.json",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
