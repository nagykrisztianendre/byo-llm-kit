{
  "name": "byo-llm-kit",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "vitest.explorer"
      ]
    }
  },
  "onCreateCommand": "corepack enable && corepack prepare pnpm@9.15.0 --activate && pnpm install",
  "postStartCommand": "pnpm --version",
  "remoteUser": "node"
}
